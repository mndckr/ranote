<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pixiewood manifest for the real rnote UI (ticket #6).

  Run from this directory via scripts/setup.sh.
  Revisions match misc/android/versions.env; setup.sh fails on drift.

  Pixiewood turns the AppStream mediatype below into a VIEW filter for
  application/rnote. The .rnote extension/octet-stream filter that file
  managers need is added by scripts/patch-manifest.py after generation.
-->
<app xmlns="https://sp1rit.arpa/pixiewood/" xmlns:xi="http://www.w3.org/2001/XInclude">
  <metainfo vercalc="sem121010">
    <xi:include href="src://com.github.flxzt.rnote.metainfo.xml" parse="xml"/>
  </metainfo>
  <style>
    <theme name="adw"/>
    <icon type="generate">
      <drawable target="foreground" type="avd" path="src://icons/ic-launcher-foreground.xml"/>
      <color target="background">#1c1c1c</color>
    </icon>
  </style>
  <dependencies>
    <glib revision="802d1893cd5f4928991b5295263f1700311a3490">
      <patch>hack</patch>
      <patch>android-ndk-zlib</patch>
    </glib>
    <cairo/>
    <fontconfig revision="6d0a98982ec351c165c9224c8b7dbdfca3010e47"/>
    <gtk revision="bd25f1e2dc2c2fbf3b8864e61afe642910ba359c">
      <patch>android-jni-thread</patch>
      <patch>android-filechooser-alerts</patch>
    </gtk>
    <libadwaita revision="dab4459427c9e518af87d1c54fe1f1f410bc9752"/>
  </dependencies>
  <build target="rnote">
    <architectures>
      <arch>aarch64</arch>
      <arch>x86_64</arch>
    </architectures>
    <!--
      NDK 27 still aligns ELF LOAD segments to 4 KB. Android 16+ flags such
      apps and 16 KB-page devices cannot load them, so align every GTK lib to
      16 KB. The build-id flag is repeated because a command-line option
      replaces the cross file's c_link_args instead of extending them.
    -->
    <configure-options>
      <option>-Dc_link_args=-Wl,--build-id=sha1 -Wl,-z,max-page-size=16384</option>
      <option>-Dcpp_link_args=-Wl,--build-id=sha1 -Wl,-z,max-page-size=16384</option>
    </configure-options>
  </build>
</app>
