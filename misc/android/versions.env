# Pinned Android smoke-test toolchain.
#
# Sourced by misc/android/scripts/*.sh. Keep versions and commits together:
# a version without its commit is not a pin.
#
# GTK/libadwaita/GLib are fetched by pixiewood into smoke/subprojects/.
# Pixiewood itself is fetched into the user cache, not into this repo.

# --- Android SDK / NDK -------------------------------------------------------
# NDK is the version GTK's own Android CI installs (gtk/.gitlab-ci/android-sdk.sh).
NDK_VERSION="27.2.12479018"
ANDROID_API="36"
BUILD_TOOLS_VERSION="36.0.0"
# command-line tools only, from developer.android.com/studio#command-line-tools-only
CMDLINE_TOOLS_VERSION="15859902"
CMDLINE_TOOLS_SHA256="4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583"

# --- Gradle / JDK ------------------------------------------------------------
# These come from the Gradle project generated by the pinned pixiewood commit
# (generate/skel.tar): gradle-wrapper.properties and gradle/libs.versions.toml.
GRADLE_VERSION="9.6.0"
GRADLE_SHA256="bbaeb2fef8710818cf0e261201dab964c572f92b942812df0c3620d62a529a01"
AGP_VERSION="9.4.1"
# Gradle 9.6 and AGP 9.x run on JDK 17+; pin the current LTS.
JDK_VERSION="21"

# --- GTK stack ---------------------------------------------------------------
GTK_VERSION="4.22.5"
GTK_COMMIT="bd25f1e2dc2c2fbf3b8864e61afe642910ba359c"
# Pinned beyond GTK's wrap: fontconfig main requires meson >= 1.11 and moved
# FcFreeTypeQueryAll out of fontconfig.h, which pango 1.56 still includes.
FONTCONFIG_VERSION="2.17.1"
FONTCONFIG_COMMIT="6d0a98982ec351c165c9224c8b7dbdfca3010e47"
# Last 1.10.alpha snapshot that still requires GTK >= 4.21.1. 1.9.4 pulls the
# appstream fallback, whose main branch dropped the svg-support option and now
# needs libcurl/libfyaml cross-builds; 1.10 replaced appstream with ministream.
LIBADWAITA_VERSION="1.10.alpha"
LIBADWAITA_COMMIT="dab4459427c9e518af87d1c54fe1f1f410bc9752"
GLIB_VERSION="2.88.4"
GLIB_COMMIT="802d1893cd5f4928991b5295263f1700311a3490"

# --- Build driver ------------------------------------------------------------
# pixiewood (GTK's Android builder). meson >= 1.9 is required for
# executable(android_exe_type: 'application').
PIXIEWOOD_COMMIT="001bfc0cae770438cc051458afc455564e83e3aa"
MESON_VERSION="1.12.1"

# --- Rust (rnote-ui app build) ------------------------------------------------
# rnote's workspace MSRV; Android targets for aarch64 tablets and x86_64 emulators.
RUST_MINIMUM="1.89"
RUST_TARGETS="aarch64-linux-android x86_64-linux-android"
